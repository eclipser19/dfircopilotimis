# Velociraptor API client config (contains private key + certs) — never commit
api_client.yaml
*.config.yaml

# Velociraptor runtime files next to the code: client writebacks hold the client's private key,
# remap files name your evidence paths, binaries are large. Root-level names used in the docs too.
*.writeback.yaml
*.writeback.yaml.bak
deaddisk*.yaml
/ou.yaml
/injector.yaml
/corpsec.yaml
velociraptor*.exe
/velociraptor
/velociraptor-v*

# Secrets
.env
*.key
*.pem

# Python
__pycache__/
*.pyc
.venv/
venv/

# Case data: databases (evidence), chats and outputs. Each case keeps it in cases/<id>/data/;
# case_data/ is the layout from before (and the legacy root case).
cases/*/data/
case_data/
reports/
output/

# Accounts (password hashes), server settings (may hold an API key) and Streamlit secrets — never commit
auth.yaml
server.yaml
.streamlit/secrets.toml

# Lessons learned on this server (shared by its cases; may describe your environment)
learned_knowledge.yaml

# Benchmark runs (cases/bench-*/, data included, and their results)
cases/bench-*/
benchmark_results/
feedback_exports/

# Evidence images kept next to the code (never commit evidence)
imagetest/
*.ad1
*.E0[0-9]
*.mem

# Python packages brought for an install without internet (DEPLOY.md, Linux)
wheels/
