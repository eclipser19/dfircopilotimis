# One Velociraptor dead-disk client per evidence image: dfir-deaddisk@<name> (deploy/add-image.sh sets it up).
[Unit]
Description=Velociraptor dead-disk client for image %i
After=dfir-velociraptor.service
Requires=dfir-velociraptor.service

[Service]
User=dfir
Group=dfir
ExecStart=/usr/local/bin/velociraptor --config /srv/dfir/deaddisk/%i/client.config.yaml --remap /srv/dfir/deaddisk/%i/remap.yaml client
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
