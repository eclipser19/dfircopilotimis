# DFIR Copilot: Velociraptor, every image's dead-disk client and the web app (python -m copilot.install start).
[Unit]
Description=DFIR Copilot (Velociraptor, image clients, web app)
After=network-online.target
Wants=network-online.target

[Service]
User=dfir
Group=dfir
# The code folder belongs to root: the copilot runs in the data folder (DFIR_WORK_DIR in the env file).
WorkingDirectory=/srv/dfir/work
EnvironmentFile=/etc/dfir-copilot/env
# Keys, settings and case data readable by the dfir account and group only.
UMask=0027
# start's own lines reach journalctl -u dfir-copilot as they are printed.
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/dfir-copilot/.venv/bin/python -m copilot.install start
Restart=on-failure
RestartSec=10
# A normal stop lets running questions finish; one cut off is offered for Continue after the restart.
TimeoutStopSec=600

[Install]
WantedBy=multi-user.target
