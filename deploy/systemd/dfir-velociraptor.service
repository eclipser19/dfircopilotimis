# Velociraptor server for DFIR Copilot: API (8001), GUI (8889) and frontend (8000) on localhost only.
[Unit]
Description=Velociraptor server for DFIR Copilot
After=network.target

[Service]
User=dfir
Group=dfir
ExecStart=/usr/local/bin/velociraptor --config /srv/dfir/velociraptor/server.config.yaml frontend
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
